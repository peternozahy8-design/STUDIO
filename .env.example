# Copy to .env (project root or worker/) and edit. Lines starting with # are ignored.
PORT=8787
# Extra allowed browser origins (comma separated). localhost / 127.0.0.1 on any port are always allowed.
# ALLOWED_ORIGINS=https://USERNAME.github.io
# WORKER_TOKEN=change-me

# --- Wan image-to-video (ComfyUI) ---
WAN_BASE_URL=http://127.0.0.1:8188
# WAN_WORKFLOW=worker/workflows/wan_i2v_api.json
# WAN_MODEL=wan2.1_i2v_480p_14B_fp8   # only used if your workflow contains {{MODEL}}
# WAN_OUTPUT_DIR=./worker/data
# I2V_HTTP_URL=https://your-gpu-endpoint/generate   # alternative to ComfyUI

# --- Piper TTS ---
# PIPER_BIN=piper
# PIPER_MODEL_EN=C:\piper\en_US-lessac-medium.onnx
# PIPER_MODEL_AR=C:\piper\ar_JO-kareem-medium.onnx

# --- AI story (Ollama) ---
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# --- Keyframe images: pollinations (default, free, internet) or a1111 (local Stable Diffusion WebUI) ---
# IMAGE_PROVIDER=pollinations
# IMAGE_PROVIDER=a1111
# SD_URL=http://127.0.0.1:7860
